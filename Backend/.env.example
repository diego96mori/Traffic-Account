DB_HOST=127.0.0.1
DB_USER=usuario_sql
DB_PASS=cambiar_en_el_servidor
DB_NAME=observium

# Orígenes separados por coma cuando frontend y API usan dominios distintos.
CORS_ORIGINS=https://trafico.ejemplo.com

# Tres minutos. Cada worker consulta SQL como máximo una vez durante este periodo.
CACHE_TTL_SEGUNDOS=180

# Usar una ruta persistente y escribible fuera de la carpeta reemplazada al desplegar.
INVENTARIO_CPU_FILE=/var/lib/traffic-account/inventario_trafico_cpu.json
